<% content_for :title, "Đổi mật khẩu" %>

<div class="max-w-md">
  <h1 class="text-xl font-bold text-gray-900 mb-1">Đổi mật khẩu</h1>
  <p class="text-sm text-gray-500 mb-6">Tài khoản admin: <%= current_admin.email %></p>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
    <%= form_with url: admin_account_path, method: :patch, local: true, class: "space-y-5" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu hiện tại</label>
        <%= f.password_field :current_password, required: true,
              class: AdminHelper::INPUT_CLASS %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu mới</label>
        <%= f.password_field :new_password, required: true, minlength: 6,
              class: AdminHelper::INPUT_CLASS %>
        <p class="text-xs text-gray-400 mt-1">Tối thiểu 6 ký tự.</p>
      </div>

      <%= f.submit "Cập nhật mật khẩu",
            class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 transition cursor-pointer" %>
    <% end %>
  </div>
</div>
